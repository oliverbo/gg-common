{
    "name": "@oliverbo/gg-common",
    "version": "5.0.0-rc.1",
    "description": "Common functionality for glamglare site components",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "require": "./dist/index.js",
            "default": "./dist/index.js"
        },
        "./model": {
            "types": "./dist/model/index.d.ts",
            "require": "./dist/model/index.js",
            "default": "./dist/model/index.js"
        },
        "./post-tools": {
            "types": "./dist/tools/postTools.d.ts",
            "require": "./dist/tools/postTools.js",
            "default": "./dist/tools/postTools.js"
        }
    },
    "typesVersions": {
        "*": {
            "model": [
                "dist/model/index.d.ts"
            ],
            "post-tools": [
                "dist/tools/postTools.d.ts"
            ]
        }
    },
    "files": [
        "dist",
        "MIGRATION.md"
    ],
    "scripts": {
        "test": "jest",
        "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
        "prepare": "npm run clean && tsc",
        "watch": "tsc --watch"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/oliverbo/gg-common.git"
    },
    "keywords": [
        "music",
        "blog"
    ],
    "author": "Oliver Bouchard",
    "license": "ISC",
    "bugs": {
        "url": "https://github.com/oliverbo/gg-common/issues"
    },
    "homepage": "https://github.com/oliverbo/gg-common#readme",
    "devDependencies": {
        "@types/jest": "^28.1.6",
        "jest": "^29.0.3",
        "ts-jest": "^29.0.2",
        "typescript": "^4.7.4"
    },
    "jest": {
        "preset": "ts-jest",
        "clearMocks": true,
        "coverageDirectory": "coverage",
        "coverageProvider": "v8",
        "testEnvironment": "node",
        "modulePathIgnorePatterns": [
            "<rootDir>/dist/",
            "node_modules"
        ]
    }
}
